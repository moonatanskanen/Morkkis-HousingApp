<Window x:Class="HousingApp.LaskutAjalta"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HousingApp"
        xmlns:invoices="clr-namespace:HousingApp.Invoices"
        mc:Ignorable="d"
        Title="Laskut aikaväliltä" Height="720" Width="1280" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.DataContext>
        <invoices:Invoice/>
    </Window.DataContext>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Pictures/transparenttausta.png" />
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="27*"/>
            <RowDefinition Height="677*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="151*" />
            <ColumnDefinition Width="1119*"/>
        </Grid.ColumnDefinitions>

        <!--menu-->
        <StackPanel Grid.ColumnSpan="2">
            <Menu Height="25" Background="#FF6CAF84">
                <MenuItem Margin="0,2,0,0">
                    <MenuItem.Header>
                        <Image Source="/Invoices/hamburger_menu_picture.jpg" Opacity="0.8" Height="20"/>
                    </MenuItem.Header>
                    <MenuItem Header="Tiedot" Click="TiedotClick" FontFamily="Carlito" FontSize="16"/>
                    <MenuItem Header="Poistu" Click="PoistuClick" FontFamily="Carlito" FontSize="16"/>
                </MenuItem>
            </Menu>
        </StackPanel>

        <StackPanel Margin="0,2,0,1" Grid.Row="1" Grid.Column="1">
            <!--laskulista-->
            <DataGrid Name="dg" Grid.Row="3" AutoGenerateColumns="False" Margin="3,7,3,0" FontFamily="Carlito" FontSize="16">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="70" Header="LaskuID" Binding="{Binding LaskuID}" IsReadOnly="True"/>
                    <DataGridTextColumn Width="100" Header="Päivämäärä" Binding="{Binding Paivamaara}" />
                    <DataGridTextColumn Width="*" Header="Asiakkaan etunimi" Binding="{Binding AEtunimi}" />
                    <DataGridTextColumn Width="*" Header="Asiakkaan sukunimi" Binding="{Binding ASukunimi}" />

                    <DataGridTemplateColumn Header="Tiedot" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Avaa" Click="AvaaClick"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Mitätöity" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Name="CheckBox2" IsChecked="{Binding Mitatoitu}" IsEnabled="False"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
        
        <!--ulkoasu-->
        <Rectangle HorizontalAlignment="Center" Height="680" Stroke="Black" Fill="#FFCDEACF" VerticalAlignment="Center" Width="162" Grid.Row="1"/>
        <Image Source="/Pictures/morkkislogotransparent.png" Grid.Row="3" Margin="10,10,10,10" VerticalAlignment="Bottom"/>
    </Grid>
</Window>
