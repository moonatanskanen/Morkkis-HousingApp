<Window x:Class="HousingApp.ChangeLocationInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HousingApp"
        mc:Ignorable="d"
        Title="Muuta toimipisteen tietoja" Height="450" Width="800" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Pictures/transparenttausta.png" />
        </Grid.Background>
        
        <StackPanel>
            <Menu Height="25" Background="#FF6CAF84">
                <MenuItem Margin="0,2,0,0">
                    <MenuItem.Header>
                        <Image Source="/Invoices/hamburger_menu_picture.jpg" Opacity="0.8" Height="20"/>
                    </MenuItem.Header>
                    <MenuItem Header="Tiedot" Click="TiedotClick" FontFamily="Carlito" FontSize="16"/>

                </MenuItem>
            </Menu>
        </StackPanel>
        <Label Content="Valitse toimipiste" HorizontalAlignment="Left" Margin="140,113,0,0" VerticalAlignment="Top" Width="136" Height="32" BorderBrush="Black" BorderThickness="1" FontFamily="Carlito" FontSize="16"/>
        <ComboBox x:Name="LocationComboBox" FontFamily="Carlito" FontSize="16" SelectionChanged="LocationComboBoxSelectionChanged" Margin="303,112,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="178" Height="32"/>

        <Label Content="Sähköposti" HorizontalAlignment="Left" Margin="140,180,0,0" VerticalAlignment="Top" Width="104" Height="32" BorderBrush="Black" BorderThickness="1" FontFamily="Carlito" FontSize="16"/>
        <TextBox x:Name="AddEmailBox" HorizontalAlignment="Left" Margin="303,180,0,0" Text="" VerticalAlignment="Top" Height="32" Width="350" VerticalContentAlignment="Center" MaxLength="50" FontFamily="Carlito" FontSize="16"/>

        <Label Content="Osoite" HorizontalAlignment="Left" Margin="140,217,0,0" VerticalAlignment="Top" Width="105" Height="32" BorderBrush="Black" BorderThickness="1" FontFamily="Carlito" FontSize="16"/>
        <TextBox x:Name="AddOsoiteBox" HorizontalAlignment="Left" Margin="303,217,0,0" Text="" VerticalAlignment="Top" Height="32" Width="350" VerticalContentAlignment="Center" MaxLength="50"  FontFamily="Carlito" FontSize="16"/>

        <Label Content="Puhelin" HorizontalAlignment="Left" Margin="140,256,0,0" VerticalAlignment="Top" Width="105" Height="32" BorderBrush="Black" BorderThickness="1" FontFamily="Carlito" FontSize="16"/>
        <TextBox x:Name="AddPuhelinBox" HorizontalAlignment="Left" Margin="303,256,0,0" VerticalAlignment="Top" Height="32" Width="350" Text="" VerticalContentAlignment="Center" MaxLength="15" FontFamily="Carlito" FontSize="16" PreviewTextInput="PuhelinPreview"/>
        <Button  BorderBrush="#FF397352" Background="#FFD3ECDC" FontFamily="Carlito" FontSize="16" Content="Tallenna" x:Name="SaveLoactionDataButton" HorizontalAlignment="Left" Margin="303,324,0,0" VerticalAlignment="Top" Height="43" Width="167" Click="SaveLocationDataButtonClick" />
        <Button  BorderBrush="#FF397352" Background="#FFD3ECDC" FontFamily="Carlito" FontSize="16" Content="Sulje" HorizontalAlignment="Left" Margin="486,324,0,0" VerticalAlignment="Top" Height="43" Width="167" Click="ExitButtonClick"/>

    </Grid>
</Window>
