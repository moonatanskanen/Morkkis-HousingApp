<Window x:Class="HousingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HousingApp"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Title="Valitse toimipiste" Height="720" Width="1280">
    <Grid>
        
        <Image Source="Pictures/morokkis.png" Stretch="Fill"></Image>
        
        
        <!--Tuki-nappi vasempaan yläkulmaa-->
        <Button Content="Tuki" Width="84" Height="25" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"
        Click="InfoButton_Click" FontFamily="Carlito" FontSize="16" BorderBrush="#FF397352" Background="#FFD3ECDC" />
        <!--Toimipiste valitaan ComboBoxissa-->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="200" Height="216">
            <TextBlock Text="Valitse toimipiste" FontSize="20" FontWeight="Bold" TextAlignment="Center" FontFamily="Carlito"/>
            <ComboBox x:Name="OfficeComboBox" Height="30" Width="200" DisplayMemberPath="Nimi" FontFamily="Carlito" FontSize="16"/>
            <Border Height="20" Background="Transparent"/>
            <Button Content="Jatka" Height="34" Width="116" Click="OpenMorkkisWindow" HorizontalAlignment="Center" FontFamily="Carlito" FontSize="16" BorderBrush="#FF397352" Background="#FFD3ECDC"/>
            <Button Content="Muuta toimipisteen tietoja" Height="34" Width="198" Click="OpenChangeLocationInfo" FontFamily="Carlito" FontSize="16" BorderBrush="#FF397352" Background="#FFD3ECDC"/>
        </StackPanel>
    </Grid>
</Window>
