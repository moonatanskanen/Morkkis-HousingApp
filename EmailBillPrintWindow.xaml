<Window x:Class="HousingApp.EmailBillPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HousingApp"
        mc:Ignorable="d"
        Title="Sähköpostilasku" Height="550" Width="500" WindowStartupLocation="CenterScreen">

    <StackPanel Margin="10,10,10,3" Orientation="Vertical">
        <Label Content="Hei!" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
        <Label Content="Kiitos varauksestasi!" FontSize="14" Margin="0,0,0,0" RenderTransformOrigin="0.493,-0.468"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
            <Label Content="Laskunumero: " FontSize="14" Margin="0,0,0,00"/>
            <Label Content="{Binding InvoiceID}" FontSize="14"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
            <Label Content="Maksaja: " FontSize="14" Margin="0,0,0,0" Height="30"/>
            <Label Content="{Binding FullName}" FontSize="14"/>
        </StackPanel>
        <Label Content="Laskua maksaessa käytä tämän laskun tili- ja viitenumeroa." FontSize="14" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
            <Label Content="Tilinumero: FI34 4832 0920 1930 14" FontSize="14" Margin="0,0,0,0"/>
            <!-- <Label Content="{Binding TESTTilinumero}" FontSize="14"/> -->
        </StackPanel>

        <Label Content="Saaja: Village People Oy" FontSize="14" Margin="0,0,0,0"/>
        <Label Content="Viitenumero: 12345 67891 12324 78954 13245" FontSize="14" Margin="0,0,0,0"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
            <Label Content="Eräpäivä: " FontSize="14" Margin="0,0,0,0"/>
            <Label Content="{Binding DueDate}" FontSize="14"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
            <Label Content="Summa: " FontSize="14" FontWeight="Bold" Margin="0,0,10,0"/>
            <Label Content="{Binding TotalPrice}" FontSize="14"/>
        </StackPanel>


        <Label Content="Ystävällisin terveisin," FontSize="14" Margin="0,0,0,0"/>
        <Label Content="Village People Oy" FontSize="14" Margin="0,0,0,0"/>

        <Image Source="/Pictures/MörkkisKuva.png" Height="127" Width="406"/>


    </StackPanel>
</Window>
