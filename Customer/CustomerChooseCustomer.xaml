<Window x:Class="HousingApp.CustomerChooseCustomer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HousingApp"
        mc:Ignorable="d"
        Title="Asiakashaku" Height="400" Width="400" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel Grid.ColumnSpan="2">
            <Menu Height="25" Background="#FF6CAF84">
                <MenuItem Margin="0,2,0,0">
                    <MenuItem.Header>
                        <Image Source="/Invoices/hamburger_menu_picture.jpg" Opacity="0.8" Height="20"/>
                    </MenuItem.Header>
                    <MenuItem Header="Tiedot" Click="TiedotClick" FontFamily="Carlito" FontSize="16"/>
                </MenuItem>
            </Menu>
        </StackPanel>

        <Label Content="Hae asiakas" HorizontalAlignment="Left" Margin="10,40,0,0" VerticalAlignment="Top" Width="101" BorderBrush="#FF397352" BorderThickness="1" FontFamily="Carlito" FontSize="16"/>

        <TextBox x:Name="SearchBox" HorizontalAlignment="Left" Margin="10,77,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="101" Height="28" BorderBrush="#FF397352" TextChanged="FilterField" FontFamily="Carlito" FontSize="16"/>

        <Button Content="Hyväksy" HorizontalAlignment="Left" Margin="10,301,0,0" VerticalAlignment="Top" FontFamily="Carlito" FontSize="16" Height="30" BorderBrush="#FF397352" Background="#FFD3ECDC" Width="101" Click="AcceptSelectedCustomerButton"
                />
        <ListBox x:Name="CustomerListBox" Margin="134,42,30,150" ItemsSource="{Binding Customers}" DisplayMemberPath="FullName" BorderBrush="#FF397352" FontFamily="Carlito" FontSize="16"/>

    </Grid>
</Window>
