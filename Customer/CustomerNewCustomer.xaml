<Window x:Class="HousingApp.CustomerNewCustomer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HousingApp"
        mc:Ignorable="d"
        Title="Asiakkaan lisäys" Height="450" Width="800" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Pictures/transparenttausta.png" />
        </Grid.Background>
        <StackPanel Grid.ColumnSpan="2">
            <Menu Height="25" Background="#FF6CAF84">
                <MenuItem Margin="0,2,0,0">
                    <MenuItem.Header>
                        <Image Source="/Invoices/hamburger_menu_picture.jpg" Opacity="0.8" Height="20"/>
                    </MenuItem.Header>
                    <MenuItem Header="Tiedot" Click="TiedotClick" FontFamily="Carlito" FontSize="16"/>
                </MenuItem>
            </Menu>
        </StackPanel>

        <Button Content="Tallenna tiedot" HorizontalAlignment="Left" Margin="474,371,0,0" VerticalAlignment="Top" FontFamily="Carlito" FontSize="16" Height="30" BorderBrush="#FF397352" Background="#FFD3ECDC" Width="136" Click="AddCustomerDetailsButton"/>
        <Button Content="Poistu" HorizontalAlignment="Left" Margin="631,371,0,0" VerticalAlignment="Top" FontFamily="Carlito" FontSize="16" Height="30" BorderBrush="#FF397352" Background="#FFD3ECDC" Width="136" Click="ExitWindowButton" />


        <Label Content="Etunimi" HorizontalAlignment="Left" Margin="179,107,0,0" VerticalAlignment="Top" Width="85" Height="30" BorderBrush="Black" BorderThickness="1" FontFamily="Carlito" FontSize="16"/>
        <TextBox x:Name="AddEtunimiBox" HorizontalAlignment="Left" Margin="318,107,0,0" Text="" VerticalAlignment="Top" Height="30" Width="311" VerticalContentAlignment="Center" MaxLength="30" PreviewTextInput="EtunimiBox_PreviewTextInput" FontFamily="Carlito" FontSize="16"/>

        <Label Content="Sukunimi" HorizontalAlignment="Left" Margin="179,142,0,0" VerticalAlignment="Top" Width="85" Height="30" BorderBrush="Black" BorderThickness="1" FontFamily="Carlito" FontSize="16"/>
        <TextBox x:Name="AddSukunimiBox" HorizontalAlignment="Left" Margin="318,142,0,0" Text="" VerticalAlignment="Top" Height="30" Width="311" VerticalContentAlignment="Center" MaxLength="30" PreviewTextInput="SukunimiBox_PreviewTextInput" FontFamily="Carlito" FontSize="16"/>

        <Label Content="Sähköposti" HorizontalAlignment="Left" Margin="179,177,0,0" VerticalAlignment="Top" Width="85" Height="30" BorderBrush="Black" BorderThickness="1" FontFamily="Carlito" FontSize="16"/>
        <TextBox x:Name="AddSahkopostiBox" HorizontalAlignment="Left" Margin="318,177,0,0" VerticalAlignment="Top" Height="30" Width="311" Text="" VerticalContentAlignment="Center" MaxLength="50" FontFamily="Carlito" FontSize="16"/>

        <Label Content="Osoite" HorizontalAlignment="Left" Margin="179,212,0,0" VerticalAlignment="Top" Width="85" Height="30" BorderBrush="Black" BorderThickness="1" FontFamily="Carlito" FontSize="16"/>
        <TextBox x:Name="AddOsoiteBox" HorizontalAlignment="Left" Margin="318,212,0,0" VerticalAlignment="Top" Height="30" Width="311" Text="" VerticalContentAlignment="Center" MaxLength="50" FontFamily="Carlito" FontSize="16"/>

        <Label Content="Puhelin" HorizontalAlignment="Left" Margin="179,247,0,0" VerticalAlignment="Top" Width="85" BorderBrush="Black" BorderThickness="1" Height="30" FontFamily="Carlito" FontSize="16"/>
        <TextBox x:Name="AddPuhelinBox" HorizontalAlignment="Left" Margin="318,247,0,0" VerticalAlignment="Top" Height="30" Width="311" Text="" VerticalContentAlignment="Center" MaxLength="15" PreviewTextInput="PuhelinBox_PreviewTextInput" FontFamily="Carlito" FontSize="16"/>

    </Grid>
</Window>
