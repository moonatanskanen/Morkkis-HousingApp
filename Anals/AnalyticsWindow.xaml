<Window x:Class="HousingApp.AnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HousingApp"
        mc:Ignorable="d"
        Title="Toimipisteen raportointi" Height="720" Width="1280" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Pictures/transparenttausta.png" />
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="275*"/>
            <RowDefinition Height="278*"/>
            <RowDefinition Height="123*"/>

        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="151*" />
            <ColumnDefinition Width="1113*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.ColumnSpan="2">
            <Menu Height="25" Background="#FF6CAF84">
                <MenuItem Margin="0,2,0,0">
                    <MenuItem.Header>
                        <Image Source="/Invoices/hamburger_menu_picture.jpg" Opacity="0.8" Height="20"/>
                    </MenuItem.Header>
                    <MenuItem Header="Tiedot" Click="TiedotClick" FontFamily="Carlito" FontSize="16"/>
                    <MenuItem Header="Poistu" Click="PoistuClick" FontFamily="Carlito" FontSize="16"/>
                </MenuItem>
            </Menu>
        </StackPanel>

        <!-- datepickerit ja tekstit ja nabbulat -->

        <Canvas Grid.Row="1" Grid.Column="1">

            <DatePicker FontFamily="Carlito" FontSize="16" x:Name="StartingDate" PreviewTextInput="OnlyDateChar" HorizontalAlignment="Left" Height="29" Width="194" Canvas.Left="338" Canvas.Top="123" />
            <DatePicker FontFamily="Carlito" FontSize="16" x:Name="EndingDate" PreviewTextInput="OnlyDateChar" HorizontalAlignment="Left" VerticalAlignment="Top" Height="29" Width="194" Canvas.Left="585" Canvas.Top="123"/>
            <Button BorderBrush="#FF397352" Background="#FFD3ECDC" FontFamily="Carlito" FontSize="16" Content="Hae kaikki tiedot" Height="30" Width="236"  Click="SearchAllInfo_Click" HorizontalAlignment="Left" Canvas.Left="443" Canvas.Top="209" VerticalAlignment="Top"/>
            <Button BorderBrush="#FF397352" Background="#FFD3ECDC" FontFamily="Carlito" FontSize="16" Content="Hae valitut tiedot" Height="30" Width="236"  Click="SearchSelectedInfo_Click" HorizontalAlignment="Left" Canvas.Left="443" Canvas.Top="174" VerticalAlignment="Top"/>
            <Label FontFamily="Carlito" FontSize="16" Content="Valitse aloituspäivämäärä" HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Left="336" Canvas.Top="78" />
            <Label FontFamily="Carlito" FontSize="16" Content="Valitse lopetuspäivämäärä" HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Left="582" Canvas.Top="78" />
            <Label FontFamily="Carlito" FontSize="16" Content="Valitse aikaväli, jolta haluat hakea varaukset." Canvas.Left="405" Canvas.Top="41" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        </Canvas>

        <!-- Datagrid -->

        <DataGrid x:Name="InfosGrid"  Grid.Row="2" Grid.Column="2" AutoGenerateColumns="False" FontFamily="Carlito" FontSize="16" IsReadOnly="True" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mökin nimi" Binding="{Binding CabinName}"/>
                <DataGridTextColumn Header="Varauksen alkamispäivä"  Binding="{Binding StartingDate, StringFormat='dd/MM/yyyy'}" />
                <DataGridTextColumn Header="Varauksen päättymispäivä" Binding="{Binding EndingDate, StringFormat='dd/MM/yyyy'}"/>
                <DataGridTextColumn Header="Varauksen palvelut" Binding="{Binding Service}"/>


            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Grid.Row="3" Header="YHTEENVETO" FontFamily="Carlito" FontSize="16" Margin="10,10,10,10" Grid.Column="1" BorderBrush="#FF397352">
            <Canvas>
                <Label Content="Varattujen mökkien määrä:" HorizontalAlignment="Left" Width="221" Canvas.Left="15" Canvas.Top="4" VerticalAlignment="Center"/>
                <Label Content="Varattujen palveluiden määrä:" HorizontalAlignment="Left" Width="230" Canvas.Left="15" Canvas.Top="32" VerticalAlignment="Center"/>

                <TextBox x:Name="cabinstxt" TextWrapping="Wrap"  Width="120" Canvas.Left="250" Canvas.Top="8" IsReadOnly="True" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBox x:Name="servicestxt" TextWrapping="Wrap" Width="120" Canvas.Left="250" Canvas.Top="36" IsReadOnly="True" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Canvas>
        </GroupBox>
        <Rectangle  Height="695" Stroke="Black" Fill="#FFCDEACF" Width="150" Grid.Row="1" Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Image Source="/Pictures/morkkislogotransparent.png" Grid.Row="3" Margin="10,10,10,10" VerticalAlignment="Bottom"/>
    </Grid>
</Window>
