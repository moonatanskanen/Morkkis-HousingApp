<Window x:Class="HousingApp.HousingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HousingApp"
        mc:Ignorable="d"
        Title="Mökkitoiminto" Height="350" Width="500" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Pictures/transparenttausta.png" />
        </Grid.Background>
        <StackPanel>
            <Menu Height="25" Background="#FF6CAF84">
                <MenuItem Margin="0,2,0,0">
                    <MenuItem.Header>
                        <Image Source="/Invoices/hamburger_menu_picture.jpg" Opacity="0.8" Height="20"/>
                    </MenuItem.Header>
                    <MenuItem Header="Tiedot" Click="TiedotClick" FontFamily="Carlito" FontSize="16"/>
                    <MenuItem Header="Apua" Click="ShowInfoMessage" FontFamily="Carlito" FontSize="16"/>
                </MenuItem>
            </Menu>
        </StackPanel>

        <Label Content="Valitse mökkitoiminto" HorizontalAlignment="Center" Margin="0,68,0,0" VerticalAlignment="Top" FontFamily="Carlito" FontSize="25" Width="232"/>
        <Button Content="Mökin tiedot" HorizontalAlignment="Center" Margin="0,125,0,0" VerticalAlignment="Top" Width="170" Click="OpenHousingInfoWindow" FontFamily="Carlito" FontSize="16" Height="33" BorderBrush="#FF397352" Background="#FFD3ECDC"/>
        <Button Content="Mökin varaukset" HorizontalAlignment="Center" Margin="0,163,0,0" VerticalAlignment="Top" Width="170" Click="OpenReservationWindow" FontFamily="Carlito" FontSize="16" Height="33" BorderBrush="#FF397352" Background="#FFD3ECDC"/>
        <Button Content="Poistu" HorizontalAlignment="Center" Margin="0,212,0,0" VerticalAlignment="Top" Width="124" Click="CloseWindow" FontFamily="Carlito" FontSize="16" Height="28" BorderBrush="#FF397352" Background="#FFD3ECDC"/>
    </Grid>
</Window>
