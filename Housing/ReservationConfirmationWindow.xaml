<Window x:Class="HousingApp.ReservationConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HousingApp"
        mc:Ignorable="d"
        Title="Varauksen varmistus" Height="800" Width="500" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Grid>

        <StackPanel>
            <Menu Height="25" Background="#FF6CAF84">
                <MenuItem Margin="0,2,0,0">
                    <MenuItem.Header>
                        <Image Source="/Invoices/hamburger_menu_picture.jpg" Opacity="0.8" Height="20"/>
                    </MenuItem.Header>
                    <MenuItem Header="Tiedot" Click="TiedotClick" FontFamily="Carlito" FontSize="16"/>
                    <MenuItem Header="Apua" Click="ShowInfoMessage" FontFamily="Carlito" FontSize="16"/>
                </MenuItem>
            </Menu>
        </StackPanel>

        <Label Content="Varmista tietojen oikeellisuus" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,36,0,0" FontWeight="Bold" FontFamily="Carlito" FontSize="20" Height="34"/>

        <Rectangle HorizontalAlignment="Center" Height="181" Margin="0,85,0,0" Stroke="#FF095009" VerticalAlignment="Top" Width="400"/>
        <Label Content="{Binding FirstName}" HorizontalAlignment="Left" Margin="68,100,0,0" VerticalAlignment="Top" FontFamily="Carlito" FontSize="16"/>
        <Label Content="{Binding LastName}" HorizontalAlignment="Left" Margin="68,131,0,0" VerticalAlignment="Top" FontFamily="Carlito" FontSize="16"/>
        <Label Content="{Binding Address}" HorizontalAlignment="Left" Margin="68,161,0,0" VerticalAlignment="Top" FontFamily="Carlito" FontSize="16"/>
        <Label Content="{Binding Phone}" HorizontalAlignment="Left" Margin="68,191,0,0" VerticalAlignment="Top" FontFamily="Carlito" FontSize="16"/>
        <Label Content="{Binding Email}" HorizontalAlignment="Left" Margin="68,221,0,0" VerticalAlignment="Top" FontFamily="Carlito" FontSize="16"/>

        <Label Content="{Binding Office}" HorizontalAlignment="Left" Margin="329,100,0,0" VerticalAlignment="Top" FontFamily="Carlito" FontSize="16" />
        <Label Content="{Binding Cabin}" HorizontalAlignment="Left" Margin="329,131,0,0" VerticalAlignment="Top" FontFamily="Carlito" FontSize="16"/>
        <Label Content="{Binding StartDate}" HorizontalAlignment="Left" Margin="329,161,0,0" VerticalAlignment="Top" FontFamily="Carlito" FontSize="16" RenderTransformOrigin="0.693,0.669"/>
        <Label Content="{Binding EndDate}" HorizontalAlignment="Left" Margin="329,191,0,0" VerticalAlignment="Top" FontFamily="Carlito" FontSize="16"/>


        <ListView ItemsSource="{Binding InvoiceRows}" Margin="39,288,39,287" FontFamily="Carlito" FontSize="16" BorderBrush="#FF095009">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Tuote" DisplayMemberBinding="{Binding Name}" Width="220"/>
                    <GridViewColumn Header="Määrä" DisplayMemberBinding="{Binding Amount}" Width="60"/>
                    <GridViewColumn Header="à-Hinta" DisplayMemberBinding="{Binding Price}" Width="60"/>
                    <GridViewColumn Header="Hinta" DisplayMemberBinding="{Binding TotalPrice}" Width="60"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Label Content="KOKONAISHINTA :                            €" HorizontalAlignment="Left" Margin="50,503,0,0" VerticalAlignment="Top" FontFamily="Carlito" FontSize="16"/>
        <Label Content="{Binding TotalPrice}" HorizontalAlignment="Left" Margin="188,503,0,0" VerticalAlignment="Top" HorizontalContentAlignment="Left" FontFamily="Carlito" FontSize="16"/>
        <Label Content="ERÄPÄIVÄ: " HorizontalAlignment="Left" Margin="50,533,0,0" VerticalAlignment="Top" FontFamily="Carlito" FontSize="16"/>
        <Label Content="PÄIVÄYS: " HorizontalAlignment="Left" Margin="50,563,0,0" VerticalAlignment="Top" FontFamily="Carlito" FontSize="16"/>
        <Label ContentStringFormat="dd-MM-yyyy" Content="{Binding Date}" HorizontalAlignment="Left" Margin="132,563,0,0" VerticalAlignment="Top" FontFamily="Carlito" FontSize="16"/>
        <Label ContentStringFormat="dd-MM-yyyy" Content="{Binding DueDate}" HorizontalAlignment="Left" Margin="137,533,0,0" VerticalAlignment="Top" FontFamily="Carlito" FontSize="16"/>



        <Button Content="Hyväksy ja tulosta" Margin="96,0,265,15" VerticalAlignment="Bottom" Height="35" FontFamily="Carlito" FontSize="16" BorderBrush="#FF397352" Background="#FFD3ECDC" Click="ConfirmAndExit"/>
        <Button Content="Hylkää" Margin="259,0,96,15" VerticalAlignment="Bottom" Height="35" FontFamily="Carlito" FontSize="16" BorderBrush="#FF397352" Background="#FFD3ECDC" Click="DiscardAndExit" />

        <Label Content="Valitse tulostettavan laskun tyyppi" Margin="132,612,114,121" FontFamily="Carlito" FontSize="16" FontWeight="Bold" Width="254"/>
        <CheckBox x:Name="CBemail" Content="Sähköpostilasku" HorizontalAlignment="Center" Margin="0,673,0,0" VerticalAlignment="Top" IsChecked="False" FontFamily="Carlito" FontSize="16" Click="ChooseInvoiceType"/>
        <CheckBox x:Name="CBpaper" Content="Paperilasku" HorizontalAlignment="Center" Margin="0,649,0,0" VerticalAlignment="Top" IsChecked="True" FontFamily="Carlito" FontSize="16" Click="ChooseInvoiceType"/>


    </Grid>
</Window>
