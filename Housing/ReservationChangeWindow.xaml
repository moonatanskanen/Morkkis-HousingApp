<Window x:Class="HousingApp.ReservationChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HousingApp"
        mc:Ignorable="d"
        Title="Varauksen tiedot" Height="625" Width="500" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="27*"/>
            <RowDefinition Height="281*"/>
            <RowDefinition Height="202*"/>
            <RowDefinition Height="99*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <Menu Height="25" Background="#FF6CAF84">
                <MenuItem Margin="0,2,0,0">
                    <MenuItem.Header>
                        <Image Source="/Invoices/hamburger_menu_picture.jpg" Opacity="0.8" Height="20"/>
                    </MenuItem.Header>
                    <MenuItem Header="Tiedot" Click="TiedotClick" FontFamily="Carlito" FontSize="16"/>
                    <MenuItem Header="Apua" Click="ShowInfoMessage" FontFamily="Carlito" FontSize="16"/>
                </MenuItem>
            </Menu>
        </StackPanel>

        <!-- ASIAKKAAN TIEDOT -->

        <Rectangle HorizontalAlignment="Left" Height="165" Margin="7,55,0,0" Grid.Row="1" VerticalAlignment="Top" Width="225" Stroke="#FF095009"/>
        <Label Content="Asiakastiedot" HorizontalAlignment="Left" Margin="10,25,0,0" Grid.Row="1" VerticalAlignment="Top" FontFamily="Carlito" FontSize="16" FontWeight="Bold" Height="29" Width="99"/>
        <TextBox IsReadOnly="True" HorizontalAlignment="Left" Margin="15,65,0,0" Grid.Row="1" TextWrapping="Wrap" Text="{Binding Customer.FirstName}" VerticalAlignment="Top" Width="210" Height="25" FontFamily="Carlito" FontSize="16"/>
        <TextBox IsReadOnly="True" HorizontalAlignment="Left" Margin="15,95,0,0" Grid.Row="1" TextWrapping="Wrap" Text="{Binding Customer.LastName}" VerticalAlignment="Top" Width="210" Height="25" FontFamily="Carlito" FontSize="16"/>
        <TextBox IsReadOnly="True" HorizontalAlignment="Left" Margin="15,125,0,0" Grid.Row="1" TextWrapping="Wrap" Text="{Binding Customer.Address}" VerticalAlignment="Top" Width="210" Height="25" FontFamily="Carlito" FontSize="16"/>
        <TextBox IsReadOnly="True" HorizontalAlignment="Left" Margin="15,155,0,0" Grid.Row="1" TextWrapping="Wrap" Text="{Binding Customer.Email}" VerticalAlignment="Top" Width="210" Height="25" FontFamily="Carlito" FontSize="16"/>
        <TextBox IsReadOnly="True" HorizontalAlignment="Left" Margin="15,185,0,0" Grid.Row="1" TextWrapping="Wrap" Text="{Binding Customer.Phone}" VerticalAlignment="Top" Width="210" Height="25" FontFamily="Carlito" FontSize="16"/>

        <!-- MUUT TIEDOT -->

        <Rectangle HorizontalAlignment="Right" Height="165" Margin="0,55,7,0" Grid.Row="1" Stroke="#FF095009" VerticalAlignment="Top" Width="225"/>
        <Label Content="Varaustiedot" Margin="268,25,120,0" Grid.Row="1" VerticalAlignment="Top" FontFamily="Carlito" FontSize="16" FontWeight="Bold" Height="29"/>
        <TextBox IsReadOnly="True" HorizontalAlignment="Right" Margin="0,65,15,0" Grid.Row="1" TextWrapping="Wrap" Text="{Binding Cabin.Name}" VerticalAlignment="Top" Width="210" Height="25" FontFamily="Carlito" FontSize="16"/>
        <Label Content="Aloituspäivä" Margin="275,96,109,0" Grid.Row="1" VerticalAlignment="Top" FontFamily="Carlito" FontSize="16" FontWeight="Bold" Height="29" Width="116"/>
        <DatePicker HorizontalAlignment="Right" Margin="0,125,15,0" Grid.Row="1" SelectedDate="{Binding Start, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="210" Height="25" FontFamily="Carlito" FontSize="16" HorizontalContentAlignment="Left"/>
        <Label Content="Lopetuspäivä" Margin="275,156,109,0" Grid.Row="1" VerticalAlignment="Top" FontFamily="Carlito" FontSize="16" FontWeight="Bold" Height="29" Width="116"/>
        <DatePicker HorizontalAlignment="Right" Margin="0,185,15,0" Grid.Row="1" SelectedDate="{Binding End, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Width="210" Height="25" FontFamily="Carlito" FontSize="16" HorizontalContentAlignment="Left"/>

        <!-- TUOTEVALINTA -->
        <StackPanel Grid.Row="1" Margin="0,281,0,0" Grid.RowSpan="3">
            <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding Services}" BorderBrush="Black" x:Name="DataRows" FontFamily="Carlito" FontSize="16" CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn IsReadOnly="True" Width="*" Header="Tuote" Binding="{Binding Name}" CanUserResize="False"/>
                    <DataGridTextColumn IsReadOnly="True" Width="60" Header="Määrä" Binding="{Binding Amount}" CanUserResize="False"/>
                    <DataGridTextColumn IsReadOnly="True" Width="62" Header="à-Hinta" Binding="{Binding Price}" CanUserResize="False"/>
                    <DataGridTextColumn IsReadOnly="True" Width="60" Header="Hinta" Binding="{Binding TotalPrice}" CanUserResize="False"/>
                    <DataGridCheckBoxColumn Width="60" Header="Valitse" Binding="{Binding Delete}" CanUserResize="False"/>
                </DataGrid.Columns>
            </DataGrid>
            <Button Content="Poista valitut" Width="104" Margin="0,10,0,0" FontSize="16" BorderBrush="#FF397352" Background="#FFD3ECDC" Click="DeleteRows" Height="30"/>
            <Button Content="Lisää uusi" Width="104" Margin="0,10,0,0" FontSize="16" BorderBrush="#FF397352" Background="#FFD3ECDC" Click="AddNewRow" Height="30"/>
        </StackPanel>

        <Button Grid.Row="3" Content="Valmis" Margin="259,50,128,0" VerticalAlignment="Top" Height="35" FontSize="16" BorderBrush="#FF397352" Background="#FFD3ECDC" Click="OpenReservationConfirmationWindow"/>
        <Button Grid.Row="3" Content="Peruuta" Margin="367,50,0,0" VerticalAlignment="Top" Width="100" Height="35" FontSize="16" BorderBrush="#FF397352" Background="#FFD3ECDC" Click="DiscardAndClose"/>

    </Grid>
</Window>
