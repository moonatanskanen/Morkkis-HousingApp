<Window x:Class="HousingApp.ReservationCancelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HousingApp"
        mc:Ignorable="d"
        Title="Varauksen peruminen" Height="400" Width="500" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel>
            <Menu Height="25" Background="#FF6CAF84">
                <MenuItem Margin="0,2,0,0">
                    <MenuItem.Header>
                        <Image Source="/Invoices/hamburger_menu_picture.jpg" Opacity="0.8" Height="20"/>
                    </MenuItem.Header>
                    <MenuItem Header="Tiedot" Click="TiedotClick" FontFamily="Carlito" FontSize="16"/>
                    <MenuItem Header="Apua" Click="ShowInfoMessage" FontFamily="Carlito" FontSize="16"/>
                </MenuItem>
            </Menu>
        </StackPanel>

        <!-- ASIAKKAAN TIEDOT -->

        <Rectangle HorizontalAlignment="Left" Height="165" Margin="7,80,0,0" Grid.Row="1" Stroke="#FF095009" VerticalAlignment="Top" Width="225"/>
        <Label Content="Asiakastiedot" HorizontalAlignment="Left" Margin="10,50,0,0" Grid.Row="1" VerticalAlignment="Top" FontFamily="Carlito" FontSize="16" FontWeight="Bold"/>
        <TextBox IsReadOnly="True" HorizontalAlignment="Left" Margin="15,90,0,0" Grid.Row="1" TextWrapping="Wrap" Text="{Binding Customer.FirstName}" VerticalAlignment="Top" Width="210" Height="25" FontFamily="Carlito" FontSize="16"/>
        <TextBox IsReadOnly="True" HorizontalAlignment="Left" Margin="15,120,0,0" Grid.Row="1" TextWrapping="Wrap" Text="{Binding Customer.LastName}" VerticalAlignment="Top" Width="210" Height="25" FontFamily="Carlito" FontSize="16"/>
        <TextBox IsReadOnly="True" HorizontalAlignment="Left" Margin="15,150,0,0" Grid.Row="1" TextWrapping="Wrap" Text="{Binding Customer.Address}" VerticalAlignment="Top" Width="210" Height="25" FontFamily="Carlito" FontSize="16"/>
        <TextBox IsReadOnly="True" HorizontalAlignment="Left" Margin="15,180,0,0" Grid.Row="1" TextWrapping="Wrap" Text="{Binding Customer.Email}" VerticalAlignment="Top" Width="210" Height="25" FontFamily="Carlito" FontSize="16"/>
        <TextBox IsReadOnly="True" HorizontalAlignment="Left" Margin="15,210,0,0" Grid.Row="1" TextWrapping="Wrap" Text="{Binding Customer.Phone}" VerticalAlignment="Top" Width="210" Height="25" FontFamily="Carlito" FontSize="16"/>

        <!-- MUUT TIEDOT -->

        <Rectangle HorizontalAlignment="Right" Height="165" Margin="7,80,7,0" Grid.Row="1" Stroke="#FF095009" VerticalAlignment="Top" Width="225"/>
        <Label Content="Varaustiedot" HorizontalAlignment="Left" Margin="275,50,0,0" VerticalAlignment="Top" FontFamily="Carlito" FontSize="16" FontWeight="Bold" Width="105"/>
        <TextBox IsReadOnly="True" HorizontalAlignment="Right" Margin="15,90,15,0" Grid.Row="1" TextWrapping="Wrap" Text="{Binding Cabin.Name}" VerticalAlignment="Top" Width="210" Height="25" FontFamily="Carlito" FontSize="16"/>
        <Label Content="Aloituspäivä" HorizontalAlignment="Left"  Margin="275,120,0,0" VerticalAlignment="Top" FontFamily="Carlito" FontSize="16" FontWeight="Bold" Width="105"/>
        <TextBox IsReadOnly="True" HorizontalAlignment="Right" Margin="15,150,15,0" Grid.Row="1" TextWrapping="Wrap" Text="{Binding StartDate}" VerticalAlignment="Top" Width="210" Height="25" FontFamily="Carlito" FontSize="16"/>
        <Label Content="Lopetuspäivä" HorizontalAlignment="Left"  Margin="275,180,0,0" VerticalAlignment="Top" FontFamily="Carlito" FontSize="16" FontWeight="Bold" Width="114"/>
        <TextBox IsReadOnly="True" HorizontalAlignment="Right" Margin="15,210,15,0" Grid.Row="1" TextWrapping="Wrap" Text="{Binding EndDate}" VerticalAlignment="Top" Width="210" Height="25" FontFamily="Carlito" FontSize="16"/>



        <Label Content="Haluatko varmasti peruuttaa varauksen?" HorizontalAlignment="Center" Margin="0,0,0,85" VerticalAlignment="Bottom" FontFamily="Carlito" FontSize="16" FontWeight="SemiBold"/>
        <Button Content="Kyllä" HorizontalAlignment="Center" Margin="0,0,0,50" VerticalAlignment="Bottom" FontSize="16" Height="26" BorderBrush="#FF397352" Background="#FFD3ECDC" Width="75" Click="DeleteReservation"/>
        <Button Content="Ei" HorizontalAlignment="Center" Margin="0,0,0,15" VerticalAlignment="Bottom" Height="26" FontSize="16" BorderBrush="#FF397352" Background="#FFD3ECDC" Width="75" Click="CloseWindow" />

    </Grid>
</Window>
