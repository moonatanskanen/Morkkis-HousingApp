<Window x:Class="HousingApp.MorkkisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HousingApp"
        mc:Ignorable="d"
        Title="Päävalikko" Height="720" Width="1280" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="Pictures/morkkismokit.png" />
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="13*"/>
            <RowDefinition Height="339*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="151*"/>
            <ColumnDefinition Width="1129*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Grid.RowSpan="2">
            <Menu Height="25" Background="#FF6CAF84">
                <MenuItem Margin="0,2,0,0">
                    <MenuItem.Header>
                        <Image Source="/Invoices/hamburger_menu_picture.jpg" Opacity="0.8" Height="20"/>
                    </MenuItem.Header>
                    <MenuItem Header="Tiedot" Click="TiedotClick" FontFamily="Carlito" FontSize="16"/>
                    <MenuItem Header="Poistu" Click="PoistuClick" FontFamily="Carlito" FontSize="16"/>
                </MenuItem>
            </Menu>
        </StackPanel>
        <Rectangle HorizontalAlignment="Center" Height="680" Stroke="Black" Fill="#FFCDEACF" VerticalAlignment="Center" Width="150" Grid.Row="1"/>
        <Button Content="Palvelut" HorizontalAlignment="Center" Margin="0,24,0,0" VerticalAlignment="Top" Height="24" Width="130" Click="OpenServiceWindow" Grid.Row="1" FontFamily="Carlito" FontSize="16" BorderBrush="#FF397352" Background="#FFD3ECDC"/>
        <Button Content="Laskutus" HorizontalAlignment="Center" Margin="0,53,0,0" VerticalAlignment="Top" Height="24" Width="130" Click="OpenInvoiceWindow" Grid.Row="1" FontFamily="Carlito" FontSize="16" BorderBrush="#FF397352" Background="#FFD3ECDC"/>
        <Button Content="Asiakastiedot" HorizontalAlignment="Center" Margin="0,82,0,0" VerticalAlignment="Top" Height="24" Width="130" Click="OpenCustomerWindow" Grid.Row="1" FontFamily="Carlito" FontSize="16" BorderBrush="#FF397352" Background="#FFD3ECDC"/>
        <Button Content="Raportointi" HorizontalAlignment="Center" Margin="0,111,0,0" VerticalAlignment="Top" Height="24" Width="130" Click="OpenAnalyticsWindow" Grid.Row="1" FontFamily="Carlito" FontSize="16" BorderBrush="#FF397352" Background="#FFD3ECDC"/>

        <Button x:Name="Cabin1" Content="Mökki 1" HorizontalAlignment="Left" Margin="828,189,0,0" VerticalAlignment="Top" Height="24" Width="88" Click="OpenHousingWindow" Grid.Column="1" Grid.Row="1" FontFamily="Carlito" FontSize="16" BorderBrush="#FF397352" Background="#FFD3ECDC"/>
        <Button x:Name="Cabin2" Content="Mökki 2" HorizontalAlignment="Left" Margin="507,434,0,0" VerticalAlignment="Top" Height="24" Width="88" Click="OpenHousingWindow" Grid.Column="1" Grid.Row="1" FontFamily="Carlito" FontSize="16" BorderBrush="#FF397352" Background="#FFD3ECDC"/>
        <Button x:Name="Cabin3" Content="Mökki 3" HorizontalAlignment="Left" Margin="896,603,0,0" VerticalAlignment="Top" Height="24" Width="88" Click="OpenHousingWindow" Grid.Column="1" Grid.Row="1" FontFamily="Carlito" FontSize="16" BorderBrush="#FF397352" Background="#FFD3ECDC"/>
        <Image Source="Pictures/morkkislogotransparent.png" Grid.Row="1" Margin="10,10,10,10" VerticalAlignment="Bottom"/>
    </Grid>


</Window>
